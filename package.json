{
  "name": "human-review",
  "version": "0.6.2",
  "description": "Review and edit agent-generated files and localhost pages in the browser, then send the whole batch back to your agent.",
  "author": "AcidicSoil",
  "homepage": "https://github.com/AcidicSoil/human-review#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/AcidicSoil/human-review.git"
  },
  "bugs": {
    "url": "https://github.com/AcidicSoil/human-review/issues"
  },
  "type": "module",
  "bin": {
    "human-review": "src/cli.js",
    "human-review-plan": "src/plate-review/artifact.js",
    "human-review-loa": "src/loa-review/artifact.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:plate-review": "node scripts/build-plate-review.mjs",
    "sync:plugin-skill": "node scripts/sync-plugin-skill.mjs",
    "prepack": "npm run build:plate-review && npm run sync:plugin-skill",
    "postpack": "node -e \"require('node:fs').rmSync('src/plate-review/client.bundle.js',{force:true})\"",
    "test": "node --test --test-force-exit",
    "start": "node src/cli.js"
  },
  "keywords": [
    "html",
    "markdown",
    "localhost",
    "nextjs",
    "review",
    "comments",
    "agent",
    "claude-code",
    "codex",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "@platejs/basic-nodes": "53.0.0",
    "@platejs/comment": "53.0.0",
    "@platejs/link": "53.3.1",
    "@platejs/list-classic": "53.0.0",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "platejs": "53.3.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
